# Site settings for a single-node Sunbeam install. Copy to site.env and edit.
# install.sh checks these against the host, then renders:
#   manifest.yaml                          -> sunbeam cluster bootstrap / configure
#   ../terraform/site.auto.tfvars.json     -> the undercloud's networks, region
# so Sunbeam and Terraform always agree.
#
# Values below are for mz640test on the RB4011 v4 network (mv-2112/HomeLab,
# network/RB4011_v4). Apply that router config first. For mz640, change the
# lines marked "mz640:".

# Sunbeam snap channel
RELEASE="2026.1/edge"

# Channel for the OpenStack charms. Sunbeam always asks for "<track>/stable"
# whatever the snap's channel, and 2026.1 has no stable charms yet, so
# bootstrap fails with "charm or bundle not found" (or a charm can't install
# its snap: "not available on 2026.1/stable"). This sets both the charms and
# the snaps those charms install. Empty = follow RELEASE
# (2026.1/edge snap -> 2026.1/edge charms); "default" = Sunbeam's own choice
# (use once 2026.1 is stable).
CHARM_CHANNEL=""
# One-off overrides for any other charm the same error names. rabbitmq-k8s
# has no 4.0/stable yet (a manual 2026.1 install on 5 Nov 2026 used 4.0/edge).
#   e.g. CHARM_CHANNELS="rabbitmq-k8s=4.0/edge,microovn=26.03/edge"
CHARM_CHANNELS="rabbitmq-k8s=4.0/edge"

# Names this cloud on the shared router (tenant IPv6 route tags). Default:
# the host's short name.
CLOUD_NAME="mz640test"              # mz640: "mz640"

# ---- Management: hosts, SSH, Juju, Kubernetes, Ceph, OpenStack APIs ----
# SINGLE-STACK: IPv4 OR IPv6, never both (dual-stack management trips Juju
# bugs). The family of MGMT_CIDR decides; API_RANGE must match it.
# Both clouds share VLAN 88, so each has its own API block:
#   .200-.219 mz640, .220-.239 mz640test (.252 mz640test, .253 mz640 are the hosts)
MGMT_CIDR="192.168.88.0/24"                       # VLAN 88, untagged on eno1
API_RANGE="192.168.88.220-192.168.88.239"         # mz640: "192.168.88.200-192.168.88.219"
#
# IPv6 management instead (less proven on Sunbeam; give the host a STATIC
# address in netplan, and the router must advertise fd18:aaa8:47c3:88::/64):
#   MGMT_CIDR="fd18:aaa8:47c3:88::/64"
#   API_RANGE="fd18:aaa8:47c3:88::220-fd18:aaa8:47c3:88::239"

REGION="RegionOne"

# ---- VM access: a separate NIC/VLAN, never the management network ----
# Each host: eno1 = management (VLAN 88 untagged, an access port), ens4f0 =
# VM trunk (tagged only: its cloud's external VLAN for OVS, and provider
# VLANs 11-19 / 21-29 for provider networks and SR-IOV VFs; no VLAN 88),
# ens4f1 = the private 10GbE link between the hosts. EXT_NIC must be up with
# no IPv4 address; set 'accept-ra: false' and 'link-local: []' for it in
# netplan.
EXT_NIC="ens4f0"

# flat = the NIC is an access port on the VM network
# vlan = the NIC is a trunk; OpenStack tags EXT_VLAN_ID itself
EXT_NETWORK_TYPE="vlan"
EXT_VLAN_ID="20"                    # mz640: "10"

# IPv4: floating IPs and router gateways (NATed tenant IPv4 leaves through
# here). The router runs no DHCP on this VLAN, so the range can be wide;
# .250+ is reserved for hardware.
EXT_CIDR="192.168.20.0/24"                  # mz640: "192.168.10.0/24"
EXT_GATEWAY="192.168.20.1"                  # mz640: "192.168.10.1"
EXT_RANGE="192.168.20.10-192.168.20.249"    # mz640: "192.168.10.10-192.168.10.249"
# Fixed floating IP for the admin cluster's ingress (Backstage etc.), so its
# DNS name survives rebuilds. Inside EXT_CIDR, OUTSIDE EXT_RANGE. Name it in
# the router's DNS (RB4011_v4 src/lablan/34-dns.rsc). Empty = random, changes.
PLATFORM_INGRESS_IP="192.168.20.250"        # mz640: "192.168.10.250"

# IPv6: the VLAN's /64 from the lab ULA /48. The router reaches the internet
# for it with NAT66. Leave both empty for an IPv4-only VM network.
EXT_V6_CIDR="fd18:aaa8:47c3:20::/64"        # mz640: "fd18:aaa8:47c3:10::/64"
EXT_V6_GATEWAY="fd18:aaa8:47c3:20::1"       # mz640: "fd18:aaa8:47c3:10::1"

# Tenant IPv6: every tenant network gets a /64 from this pool, routed (no
# NAT inside the lab) through its tenant router. The router needs a route per
# tenant network: tools/ipv6-routes.py generates them.
TENANT_V6_POOL="fd18:aaa8:47c3:2000::/52"   # mz640: "fd18:aaa8:47c3:1000::/52"

# ---- Ceph ----
# Disks given to MicroCeph, comma-separated, as /dev/disk/by-id paths (sdX
# names can change across reboots). ./utils/ceph-disks.py lists the candidates on
# this host and prints this line ready to paste; sudo ./utils/ceph-disks.py --zap
# wipes disks that still hold old data.
CEPH_DISKS="CHANGEME"               # e.g. /dev/disk/by-id/ata-SSD1,/dev/disk/by-id/ata-SSD2
# true lets MicroCeph wipe disks that already have data. Leave false unless
# you've checked the list above twice.
CEPH_WIPE="false"
